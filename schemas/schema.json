{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siebrand.github.io/kdt2o/schemas/schema.json",
  "title": "Kitano meal planner recipes",
  "description": "Schema for public/recipes.json. Ingredient amount and unit drive the shopping list only; raw keeps the recipe wording.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/recipe"
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "shoppingCategory": {
      "enum": [
        "Groente en fruit",
        "Zuivel en eieren",
        "Vlees, vis en vleesvervangers",
        "Brood en ontbijt",
        "Diepvries",
        "Kruiden en smaakmakers",
        "Houdbare producten"
      ]
    },
    "amount": {
      "description": "A number, or null for an unquantified ingredient. Never a string; for a range, store the maximum.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "alternative": {
      "type": "object",
      "properties": {
        "raw": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "unit": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "optional": {
          "type": "boolean"
        },
        "category": {
          "$ref": "#/$defs/shoppingCategory"
        },
        "componentId": {
          "type": "string"
        },
        "flags": {
          "$ref": "#/$defs/ingredientFlags"
        }
      },
      "required": [
        "raw",
        "amount",
        "unit",
        "name",
        "optional",
        "category"
      ],
      "additionalProperties": false
    },
    "ingredient": {
      "type": "object",
      "properties": {
        "raw": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "unit": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "optional": {
          "type": "boolean"
        },
        "category": {
          "$ref": "#/$defs/shoppingCategory"
        },
        "componentId": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "flags": {
          "$ref": "#/$defs/ingredientFlags"
        }
      },
      "required": [
        "raw",
        "amount",
        "unit",
        "name",
        "optional",
        "category"
      ],
      "additionalProperties": false
    },
    "ingredients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ingredient"
      }
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "yield": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yieldUnit": {
          "type": "string"
        },
        "yieldNote": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "availabilityNote": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "includeInShoppingList": {
          "type": "boolean"
        },
        "preparationTime": {
          "$ref": "#/$defs/minutes"
        },
        "ovenTime": {
          "$ref": "#/$defs/minutes"
        },
        "ingredients": {
          "$ref": "#/$defs/ingredients"
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "method": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "required": [
        "id",
        "title",
        "ingredients",
        "method"
      ],
      "additionalProperties": false
    },
    "dailyVariant": {
      "type": "object",
      "properties": {
        "dayIndex": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ingredients": {
          "$ref": "#/$defs/ingredients"
        },
        "method": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "required": [
        "dayIndex",
        "title",
        "ingredients",
        "method"
      ],
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Lowercase slug. Saved plans and share links store a hash of the id, so do not change it once published.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "approved": {
          "type": "boolean"
        },
        "category": {
          "enum": [
            "ontbijt",
            "lunch",
            "diner"
          ]
        },
        "portions": {
          "type": "integer",
          "minimum": 1
        },
        "multiDay": {
          "type": "boolean"
        },
        "days": {
          "type": "integer",
          "minimum": 2
        },
        "preparationTime": {
          "$ref": "#/$defs/minutes"
        },
        "ovenTime": {
          "$ref": "#/$defs/minutes"
        },
        "diet": {
          "enum": [
            [
              "vlees"
            ],
            [
              "vis"
            ],
            [
              "vlees",
              "vis"
            ],
            [
              "vegetarisch"
            ],
            [
              "vegan"
            ]
          ]
        },
        "programs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "ingredients": {
          "$ref": "#/$defs/ingredients"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "dailyVariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dailyVariant"
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "advanceNotice": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "review": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewItem"
          }
        }
      },
      "required": [
        "id",
        "title",
        "approved",
        "category",
        "portions",
        "multiDay",
        "ingredients",
        "method",
        "diet"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "multiDay": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "days"
        ]
      }
    },
    "ingredientFlag": {
      "description": "A reason to check an ingredient for people with type 2 diabetes. sweetener, honey, and sugar block approval; the other flags need a review.",
      "enum": [
        "sweetener",
        "honey",
        "sugar",
        "alcohol",
        "fruit-juice",
        "starch",
        "dried-fruit",
        "brand-product"
      ]
    },
    "ingredientFlags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ingredientFlag"
      }
    },
    "reviewItem": {
      "description": "An open point that a person must check before the recipe can be approved.",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "scaling",
            "sweetener-removed",
            "ingredient-flag",
            "nutrition",
            "category",
            "servings",
            "conversion"
          ]
        },
        "note": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "required": [
        "type",
        "note"
      ],
      "additionalProperties": false
    },
    "source": {
      "description": "Where the recipe comes from.",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": false
    }
  }
}
